{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nan-harness.local/contracts/error-report.schema.json",
  "title": "nan-harness Error Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "timestamp",
    "application",
    "failure",
    "runtime",
    "consent"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3] },
    "reportId": { "type": "string", "pattern": "^report_[a-z0-9]{12,64}$" },
    "installationId": {
      "type": "string",
      "pattern": "^installation_[a-f0-9]{32}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "nan-harness" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "buildCommit": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{7,64}$"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "stage", "panic", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^NH-[A-Z0-9-]{3,48}$" },
        "category": {
          "enum": [
            "configuration",
            "discovery",
            "planning",
            "bridge",
            "provider",
            "process",
            "tool",
            "cleanup",
            "internal"
          ]
        },
        "stage": {
          "enum": [
            "startup",
            "credential-resolution",
            "model-discovery",
            "harness-detection",
            "launch-planning",
            "launch-validation",
            "bridge-startup",
            "request-translation",
            "harness-execution",
            "tool-execution",
            "shutdown"
          ]
        },
        "panic": { "type": "boolean" },
        "retryable": { "type": "boolean" },
        "cause": {
          "enum": [
            "missing-executable",
            "not-found",
            "unsupported-version",
            "missing-credential",
            "invalid-configuration",
            "permission-denied",
            "filesystem",
            "network",
            "timeout",
            "http-status",
            "invalid-response",
            "process-start",
            "process-exit",
            "serialization",
            "invalid-data",
            "internal"
          ]
        },
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "diagnostic": { "$ref": "#/definitions/diagnostic" },
    "userGuidance": { "$ref": "#/definitions/userGuidance" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "claude-code",
            "chatgpt-desktop",
            "claude-desktop",
            "codex",
            "opencode",
            "hermes",
            "hermes-desktop",
            "pi",
            "omp",
            "prime-agent",
            "deepseek-harness",
            "openclaw",
            "cline",
            "qwen-code",
            "kimi-code",
            "aider",
            "goose",
            "fx"
          ]
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "compatibility": {
          "enum": [
            "tested",
            "supported",
            "newer-untested",
            "older-unsupported",
            "unparseable"
          ]
        }
      }
    },
    "transport": {
      "enum": [
        "direct-chat",
        "anthropic-bridge",
        "responses-bridge",
        "fx-gateway-bridge"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "harness-run",
            "harness-dry-run",
            "harness-config",
            "harness-config-remove",
            "doctor",
            "update",
            "uninstall",
            "telemetry-configuration"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osFamily", "architecture", "interactive"],
      "properties": {
        "osFamily": { "enum": ["linux", "macos", "windows", "other"] },
        "architecture": { "enum": ["x86_64", "aarch64", "other"] },
        "targetEnvironment": { "enum": ["gnu", "musl", "msvc", "other"] },
        "interactive": { "type": "boolean" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "telemetryEnabled"],
      "properties": {
        "mode": { "enum": ["automatic", "one-time"] },
        "telemetryEnabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "automatic" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "telemetryEnabled": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "one-time" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "telemetryEnabled": { "const": false } }
          }
        }
      ]
    },
    "stack": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "function"],
        "properties": {
          "module": { "type": "string", "minLength": 1, "maxLength": 160 },
          "function": { "type": "string", "minLength": 1, "maxLength": 240 },
          "inApplication": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 3 } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["installationId", "diagnostic"] }
    }
  ],
  "definitions": {
    "userGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "id", "shown", "locale", "version", "text"],
      "properties": {
        "classification": { "const": "environmental" },
        "id": { "const": "reopen-terminal" },
        "shown": { "type": "boolean" },
        "locale": { "const": "en" },
        "version": { "const": 1 },
        "text": {
          "const": "The current terminal session cannot access the project directory. Please close this terminal, open a new terminal in the project directory, and try again."
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "details"],
      "properties": {
        "reason": {
          "enum": [
            "unclassified", "legacy-report", "authentication-rejected", "invalid-request",
            "reasoning-policy-mismatch", "network-request-failed", "http-request-rejected",
            "invalid-response", "missing-executable", "invalid-executable",
            "unsupported-version", "unparseable-version", "invalid-manifest",
            "missing-manifest-entry", "process-start-failed", "process-exited",
            "process-wait-failed", "process-termination-failed", "bridge-exited",
            "invalid-launch-plan", "launch-preparation-failed", "secret-resolution-failed",
            "random-generation-failed", "filesystem-operation-failed", "serialization-failed",
            "configuration-conflict", "invalid-configuration", "missing-directory",
            "model-unavailable", "model-catalog-empty", "update-verification-failed",
            "update-replacement-failed", "user-prompt-failed", "internal-invariant"
          ]
        },
        "details": { "$ref": "#/definitions/diagnosticDetails" }
      }
    },
    "diagnosticDetails": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "general" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "endpoint"],
          "properties": {
            "kind": { "const": "bridge" },
            "endpoint": { "enum": ["models", "messages", "count-tokens", "responses", "search", "fx-gateway"] },
            "modelId": { "type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,96}$" },
            "requestedReasoning": { "enum": ["auto", "none", "low", "medium", "high", "xhigh", "other"] },
            "modelPolicy": { "enum": ["unsupported", "toggle", "effort", "always-on", "unknown"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "errorKind"],
          "properties": {
            "kind": { "const": "io" },
            "operation": { "$ref": "#/definitions/diagnosticOperation" },
            "errorKind": { "enum": ["not-found", "permission-denied", "timed-out", "connection-refused", "connection-reset", "connection-aborted", "not-connected", "address-in-use", "address-unavailable", "broken-pipe", "invalid-data", "invalid-input", "unexpected-eof", "other"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation"],
          "properties": {
            "kind": { "const": "process" },
            "operation": { "$ref": "#/definitions/diagnosticOperation" },
            "exitCode": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "component"],
          "properties": {
            "kind": { "const": "version" },
            "component": { "enum": ["application", "harness", "runtime", "manifest-schema", "state-schema", "update-candidate"] },
            "detected": { "type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,64}$" },
            "expected": { "type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "status"],
          "properties": {
            "kind": { "const": "http" },
            "operation": { "$ref": "#/definitions/diagnosticOperation" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document"],
          "properties": {
            "kind": { "const": "schema" },
            "document": { "enum": ["compatibility-manifest", "model-catalog", "launch-plan", "harness-configuration", "integration-state", "credential-receipt", "update-manifest", "update-state", "installation-receipt", "telemetry-settings"] },
            "observedVersion": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        }
      ]
    },
    "diagnosticOperation": {
      "enum": [
        "load-compatibility-manifest", "read-working-directory", "resolve-executable", "run-version-command",
        "download-installer", "run-installer", "run-post-install-check", "bind-bridge",
        "run-bridge", "prepare-launch", "start-harness", "wait-for-harness", "stop-harness",
        "discover-models", "read-configuration", "write-configuration", "remove-configuration",
        "read-credential", "write-credential", "remove-credential", "fetch-update-manifest",
        "download-update", "verify-update", "replace-executable", "remove-installation",
        "configure-telemetry"
      ]
    }
  }
}
