{
  "schemaVersion": 2,
  "launchId": "launch_01examplebridge",
  "harness": {
    "kind": "claude-code",
    "executable": "/usr/local/bin/claude",
    "detectedVersion": "2.1.233",
    "versionStatus": "tested"
  },
  "model": {
    "requestedId": "qwen3.6",
    "resolvedId": "qwen3.6",
    "availability": "discovered",
    "profileSource": "bundled",
    "qualification": "qualified",
    "warnings": []
  },
  "webSearchPolicy": "auto",
  "transport": {
    "kind": "anthropic-bridge",
    "clientProtocol": "anthropic-messages",
    "upstreamProtocol": "chat-completions",
    "listen": {
      "host": "127.0.0.1",
      "port": 0
    },
    "providerCredentialRef": "nan_api_key",
    "sessionTokenRef": "bridge_session_token"
  },
  "process": {
    "arguments": ["--settings", "{artifact:claude-settings}", "--model", "anthropic/nan/qwen3.6"],
    "workingDirectory": "/workspace/project",
    "terminal": "inherit",
    "forwardSignals": true,
    "preserveExitCode": true
  },
  "environment": {
    "public": {
      "ANTHROPIC_BASE_URL": "{runtime:bridge_base_url}",
      "ANTHROPIC_MODEL": "anthropic/nan/qwen3.6",
      "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144"
    },
    "secrets": {
      "ANTHROPIC_AUTH_TOKEN": "bridge_session_token"
    },
    "remove": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB", "NAN_API_KEY"]
  },
  "temporaryArtifacts": [
    {
      "id": "claude-settings",
      "kind": "file",
      "pathHint": "claude-settings.json",
      "mode": "0600",
      "contentTemplate": "{\"availableModels\":\"{runtime:claude_available_models}\",\"model\":\"anthropic/nan/qwen3.6\",\"permissions\":{\"disableAutoMode\":\"disable\",\"useAutoModeDuringPlan\":false},\"env\":{\"ANTHROPIC_BASE_URL\":\"{runtime:bridge_base_url}\",\"ANTHROPIC_AUTH_TOKEN\":\"{secret:bridge_session_token}\",\"CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY\":\"1\",\"CLAUDE_CODE_MAX_CONTEXT_TOKENS\":\"262144\"}}",
      "lifecycle": "launch"
    }
  ],
  "cleanup": {
    "terminateBridge": true,
    "deleteTemporaryArtifacts": true,
    "gracePeriodMs": 3000
  },
  "observability": {
    "format": "json",
    "payloadCapture": false,
    "redactEnvironmentNames": ["ANTHROPIC_AUTH_TOKEN", "NAN_API_KEY"]
  }
}
