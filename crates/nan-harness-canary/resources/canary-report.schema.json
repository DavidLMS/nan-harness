{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DavidLMS/nan-harness/blob/main/crates/nan-harness-canary/resources/canary-report.schema.json",
  "title": "nan-harness canary report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "cellId",
    "specSha256",
    "trigger",
    "tier",
    "scenario",
    "startedAt",
    "completedAt",
    "durationMilliseconds",
    "nanHarness",
    "environment",
    "harness",
    "checks",
    "outcome"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "cellId": { "type": "string", "minLength": 1 },
    "specSha256": { "$ref": "#/definitions/sha256" },
    "trigger": { "enum": ["daily", "weekly", "release", "manual"] },
    "tier": {
      "enum": [
        "installation",
        "deterministic",
        "live-core",
        "live-extended",
        "release-gate"
      ]
    },
    "scenario": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "nanHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture", "image", "profile", "runtimes"],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "enum": [
            "claude-code",
            "codex",
            "opencode",
            "hermes",
            "pi",
            "omp",
            "prime-agent",
            "deepseek-harness",
            "openclaw",
            "cline",
            "qwen-code",
            "kimi-code",
            "aider",
            "goose",
            "fx"
          ]
        },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "durationMilliseconds", "attempts"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "durationMilliseconds": { "type": "integer", "minimum": 0 },
          "attempts": { "type": "integer", "minimum": 1 },
          "detail": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "fingerprint"],
        "properties": {
          "kind": { "const": "inventory-drift" },
          "fingerprint": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "outcome": { "enum": ["passed", "failed", "infrastructure-failure"] },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "phase", "summary", "fingerprint"],
      "properties": {
        "class": {
          "enum": [
            "nan-harness",
            "harness",
            "installation",
            "provider",
            "infrastructure",
            "test-contract"
          ]
        },
        "phase": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/definitions/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "passed" } },
        "required": ["outcome"]
      },
      "then": { "not": { "required": ["failure"] } },
      "else": { "required": ["failure"] }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
